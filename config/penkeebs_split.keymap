#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <behaviors/rgbled_widget.dtsi>

/ {
    // keymap {
    //     compatible = "zmk,keymap";

    //     //  |------------------------------------------------------------------------------------------------------------------|
    //     //  |  ESC  |   1   |   2   |   3   |   4   |   5   |   6   |  |   7   |   8   |   9   |   0   |   -   |   =   |  BSPC |
    //     //  |   `   |  TAB  |   Q   |   W   |   E   |   R   |   T   |  |   Y   |   U   |   I   |   O   |   P   |   [   |   ]   |
    //     //  |   \   |  CAP  |   A   |   S   |   D   |   F   |   G   |  |   H   |   J   |   K   |   L   |   ;   |   '   |  ENT  |
    //     //  |       |  SHFT |   Z   |   X   |   C   |   V   |   B   |  |   N   |   M   |   ,   |   .   |   /   |   UP  |  SHFT |
    //     //  |  CTRL |  ALT  |  GUI  |       |  SPC  |       |       |  |       |       |  SPC  |       |  LFT  |   DN  |  RGT  |
    //     //  |------------------------------------------------------------------------------------------------------------------|

    //     default_layer {
    //         display-name = "Base";
    //         bindings = <
    //             &kp ESC   &kp N1    &kp N2   &kp N3  &kp N4    &kp N5   &kp N6     &kp N7  &kp N8  &kp N9    &kp N0  &kp MINUS &kp EQL  &kp BSPC
    //             &kp GRAVE &kp TAB   &kp Q    &kp W   &kp E     &kp R    &kp T      &kp Y   &kp U   &kp I     &kp O   &kp P     &kp LBKT &kp RBKT
    //             &kp BSLH  &kp CAPS  &kp A    &kp S   &kp D     &kp F    &kp G      &kp H   &kp J   &kp K     &kp L   &kp SEMI  &kp SQT  &kp RET
    //             &none     &kp LSHFT &kp Z    &kp X   &kp C     &kp V    &kp B      &kp N   &kp M   &kp COMMA &kp DOT &kp FSLH  &kp UP   &kp RSHFT
    //             &kp LCTRL &kp LALT  &kp LGUI &mo 1   &kp SPACE &ind_con &ind_bat   &none   &none   &kp SPACE &mo 2   &kp LEFT  &kp DOWN &kp RIGHT
    //         >;
    //     };

    //     //  |------------------------------------------------------------------------------------------------------------------|
    //     //  |       |   F1  |   F2  |   F3  |   F4  |   F5  |   F6  |  |   F7  |   F8  |   F9  |  F10  |  F11  |  F12  |  DEL  |
    //     //  |       |       |       |       |       |       |       |  |       |       |       |       |       |       |       |
    //     //  |       |       |       |       |       |       |       |  |       |       |       |       |       |       |       |
    //     //  |       |       |       |       |       |       |       |  |       |       |       |       |       |  PGUP |       |
    //     //  |       |       |       |       |       |       |       |  |  VLUP |  VLDN |       |  MUTE |  HOME |  PGDN |  END  |
    //     //  |------------------------------------------------------------------------------------------------------------------|

    //     lower_layer {
    //         display-name = "Lower";
    //         bindings = <
    //             &trans    &kp F1    &kp F2   &kp F3  &kp F4    &kp F5  &kp F6     &kp F7       &kp F8       &kp F9    &kp F10    &kp F11   &kp F12   &kp DEL
    //             &trans    &trans    &trans   &trans  &trans    &trans  &trans     &trans       &trans       &trans    &trans     &trans    &trans    &trans
    //             &trans    &trans    &trans   &trans  &trans    &trans  &trans     &trans       &trans       &trans    &trans     &trans    &trans    &trans
    //             &trans    &trans    &trans   &trans  &trans    &trans  &trans     &trans       &trans       &trans    &trans     &trans    &kp PG_UP &trans
    //             &trans    &trans    &trans   &trans  &trans    &trans  &trans     &kp C_VOL_UP &kp C_VOL_DN &trans    &kp C_MUTE &kp HOME  &kp PG_DN &kp END
    //         >;
    //     };
    // };

    ///// Right side is backwards from what it should be (above) because I'm an idiot....
    keymap {
        compatible = "zmk,keymap";

        //  |------------------------------------------------------------------------------------------------------------------|
        //  |  ESC  |   1   |   2   |   3   |   4   |   5   |   6   |  |   7   |   8   |   9   |   0   |   -   |   =   |  BSPC |
        //  |   `   |  TAB  |   Q   |   W   |   E   |   R   |   T   |  |   Y   |   U   |   I   |   O   |   P   |   [   |   ]   |
        //  |   \   |  CAP  |   A   |   S   |   D   |   F   |   G   |  |   H   |   J   |   K   |   L   |   ;   |   '   |  ENT  |
        //  | MEDIA |  SHFT |   Z   |   X   |   C   |   V   |   B   |  |   N   |   M   |   ,   |   .   |   /   |   UP  |  SHFT |
        //  |  CTRL |  ALT  |  GUI  | LOWER |  SPC  |       |       |  |       |       |  SPC  |       |  LFT  |   DN  |  RGT  |
        //  |------------------------------------------------------------------------------------------------------------------|

        default_layer {
            display-name = "Base";
            bindings = <
                &kp ESC   &kp N1    &kp N2   &kp N3  &kp N4    &kp N5   &kp N6     &kp BSPC  &kp EQL  &kp MINUS &kp N0  &kp N9    &kp N8   &kp N7
                &kp GRAVE &kp TAB   &kp Q    &kp W   &kp E     &kp R    &kp T      &kp RBKT  &kp LBKT &kp P     &kp O   &kp I     &kp U    &kp Y
                &kp BSLH  &kp CAPS  &kp A    &kp S   &kp D     &kp F    &kp G      &kp RET   &kp SQT  &kp SEMI  &kp L   &kp K     &kp J    &kp H
                &mo 2     &kp LSHFT &kp Z    &kp X   &kp C     &kp V    &kp B      &kp RSHFT &kp UP   &kp FSLH  &kp DOT &kp COMMA &kp M    &kp N
                &kp LCTRL &kp LALT  &kp LGUI &mo 1   &kp SPACE &ind_con &ind_bat   &kp RIGHT &kp DOWN &kp LEFT  &none   &kp SPACE &none    &none
            >;
        };

        //  |------------------------------------------------------------------------------------------------------------------|
        //  |       |   F1  |   F2  |   F3  |   F4  |   F5  |   F6  |  |   F7  |   F8  |   F9  |  F10  |  F11  |  F12  |  DEL  |
        //  |       |       |       |       |       |       |       |  |       |       |       |       |       |       |       |
        //  |       |       |       |       |       |       |       |  |       |       |       |       |       |       |       |
        //  |       |       |       |       |       |       |       |  |       |       |       |       |       |  PGUP |       |
        //  |       |       |       |       |       |       |       |  |       |       |       |       |  HOME |  PGDN |  END  |
        //  |------------------------------------------------------------------------------------------------------------------|

        lower_layer {
            display-name = "Lower";
            bindings = <
                &trans    &kp F1    &kp F2   &kp F3  &kp F4    &kp F5  &kp F6     &kp DEL      &kp F12      &kp F11   &kp F10    &kp F9    &kp F8   &kp F7
                &trans    &trans    &trans   &trans  &trans    &trans  &trans     &trans       &trans       &trans    &trans     &trans    &trans   &trans
                &trans    &trans    &trans   &trans  &trans    &trans  &trans     &trans       &trans       &trans    &trans     &trans    &trans   &trans
                &trans    &trans    &trans   &trans  &trans    &trans  &trans     &trans       &kp PG_UP    &trans    &trans     &trans    &trans   &trans
                &trans    &trans    &trans   &trans  &trans    &trans  &trans     &kp END      &kp PG_DN    &kp HOME  &trans     &trans    &trans   &trans
            >;
        };
        
        //  |------------------------------------------------------------------------------------------------------------------|
        //  |       |       |       |       |       |       |       |  |  BT 0 |  BT 1 |  BT 2 |  BT 3 |  BT 4 |       | BTCLR |
        //  |       |       |       |       |       |       |       |  | BTD 0 | BTD 1 | BTD 2 | BTD 3 | BTD 4 |       |       |
        //  |       |       |       |       |       |       |       |  |       |       |       |       |       |       |       |
        //  |       |       |       |       |       |       |       |  |       |       |       |       |       |       |       |
        //  |       |       |       |       |       |       |       |  |  VLUP |  VLDN |       |  MUTE |  BTPR |       |  BTNX |
        //  |------------------------------------------------------------------------------------------------------------------|

        lower_layer {
            display-name = "Media";
            bindings = <
                &trans    &trans    &trans   &trans   &trans    &trans   &trans     &bt BT_CLR   &trans    &bt BT_SEL 4  &bt BT_SEL 3  &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0
                &trans    &trans    &trans   &trans   &trans    &trans   &trans     &trans       &trans    &bt BT_DISC 4 &bt BT_DISC 3 &bt BT_DISC 2 &bt BT_DISC 1 &bt BT_DISC 0
                &trans    &trans    &trans   &trans   &trans    &trans   &trans     &trans       &trans    &trans        &trans        &trans        &trans        &trans
                &trans    &trans    &trans   &trans   &trans    &trans   &trans     &trans       &trans    &trans        &trans        &trans        &trans        &trans
                &trans    &trans    &trans   &trans   &trans    &trans   &trans     &bt BT_NXT   &trans    &bt BT_PRV    &kp C_MUTE    &trans        &kp C_VOL_DN  &kp C_VOL_UP
            >;
        };
    };
};
